# office-mcp. Every value is empty on purpose; see README.md for meanings and defaults.

# HTTP listener (defaults: 0.0.0.0 and 8000)
HOST=
PORT=
LOG_LEVEL=

# Storage: http (default) | local | memory. local and memory need OFFICE_MCP_DEV_MODE=1.
OFFICE_MCP_STORAGE=
OFFICE_MCP_DEV_MODE=
OFFICE_MCP_LOCAL_DIR=

# Proposed internal Attachment API (docs/technical/PLATFORM_DEPENDENCIES.md). Put the key in a Secret.
ATTACHMENTS_INTERNAL_URL=
ATTACHMENTS_INTERNAL_API_KEY=
